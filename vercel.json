{
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "epicwolf.agency" }],
      "destination": "https://www.epicwolf.agency/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "epicwolf.epicdevsolutions.com" }],
      "destination": "https://www.epicwolf.agency/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "epicwolf.vercel.app" }],
      "destination": "https://www.epicwolf.agency/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "missing": [{ "type": "host", "value": "www.epicwolf.agency" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
